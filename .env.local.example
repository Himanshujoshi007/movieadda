# ==============================================================================
# CineVerse Environment Configuration
# ==============================================================================

# [1] The Movie Database (TMDB) API Key (Free)
# Sign up at: https://www.themoviedb.org/signup
# Generate key at: https://www.themoviedb.org/settings/api
# If left blank, CineVerse runs in offline demo mode with curated blockbusters and trailers.
NEXT_PUBLIC_TMDB_API_KEY=

# [2] Google AdSense Publisher Client ID (Optional)
# Format: ca-pub-XXXXXXXXXXXXXXXX
# Leave blank to display preview ad placeholders.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
